@echo off
chcp 65001 > nul

echo ============================================================
echo [1/4] Проверка и установка Python-зависимостей...
echo ============================================================
:: Обновляем pip и ставим пакеты (qdrant-client, fastapi/flask и т.д.)
python -m pip install --upgrade pip
pip install -r requirements.txt

echo ============================================================
echo [2/4] Запуск Llama-сервера...
echo ============================================================
:: Заходим в папку с ламой
cd llama-b8665-bin-win-cuda-13.1-x64

:: Стартуем ламу прямо из этой папки в отдельном окне
start "Llama Server" llama-server -m Qwen3.5-9B-Q4_K_S.gguf --reasoning off -ngl 99 -b 512 --no-cache-prompt --host 127.0.0.1 --port 8080

:: Выходим обратно в корневую папку server
cd ..

echo ============================================================
echo [3/4] Запуск Python-сервиса контекста...
echo ============================================================
start "Qdrant Service" python qdrant_service.py

echo ============================================================
echo [4/4] Запуск Node.js сервера...
echo ============================================================
node server.js
